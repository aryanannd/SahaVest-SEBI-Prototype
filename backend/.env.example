# Backend Environment Variables

PORT=3000

# Supabase Credentials
SUPABASE_URL=https://pqqdkzdsnonlndgrfyfj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Setu Account Aggregator Credentials
SETU_CLIENT_ID=your_setu_client_id
SETU_CLIENT_SECRET=your_setu_client_secret
SETU_PRODUCT_INSTANCE_ID=your_setu_product_instance_id
SETU_BASE_URL=https://fiu-sandbox.setu.co/v2
SETU_WEBHOOK_SECRET=your_setu_webhook_secret
AA_LIVE=false

# OpenRouter API Key for AI Agents
OPENROUTER_API_KEY=your_openrouter_api_key

# Google Gemini API Key for fallback AI
GEMINI_API_KEY=your_gemini_api_key

# Background Jobs, Rate Limiting & Cache (Upstash Redis & Sentry)
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
UPSTASH_REDIS_URL=rediss://default:your_upstash_redis_password@your-upstash-url.upstash.io:6379
REDIS_URL=rediss://default:your_upstash_redis_password@your-upstash-url.upstash.io:6379
SENTRY_DSN=https://your_sentry_dsn@o0.ingest.sentry.io/0
SENTRY_DSN_BACKEND=https://your_sentry_dsn@o0.ingest.sentry.io/0

# Allowed CORS Origins
CORS_ORIGIN=http://localhost:5173,https://sahavest.vercel.app

# Portfolio Imports
CASPARSER_API_KEY=your_casparser_api_key
